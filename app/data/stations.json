          {
            "id": "k2",
            "rolle": "otto",
            "text": "Wenn man Material braucht, den Lehrer fragen und nicht einfach selbst nehmen.",
            "quelle": "/api/dialog/kunst/02-otto.wav"
          },
          {
            "id": "k3",
            "rolle": "frieda",
            "text": "Nur die Materialen auspacken, die man benötigt.",
            "quelle": "/api/dialog/kunst/03-frieda.wav"
