# Git LFS — Binärdateien im App-Laufzeit-Verzeichnis
# Einrichten: brew install git-lfs && git lfs install (einmalig pro Maschine/Repo)

# Panorama-Exporte (Gyro-Viewer, ADR-006)
public/stations/*.jpg filter=lfs diff=lfs merge=lfs -text
public/stations/*.webp filter=lfs diff=lfs merge=lfs -text
public/stations/360/*.jpg filter=lfs diff=lfs merge=lfs -text
public/stations/360/*.webp filter=lfs diff=lfs merge=lfs -text
