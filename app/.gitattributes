# Git LFS — Binärdateien im App-Laufzeit-Verzeichnis
# Einrichten: brew install git-lfs && git lfs install (einmalig pro Maschine/Repo)

# Panorama-Exporte (Gyro-Viewer, ADR-006)
public/stations/*.jpg filter=lfs diff=lfs merge=lfs -text
public/stations/*.webp filter=lfs diff=lfs merge=lfs -text
public/stations/360/*.jpg filter=lfs diff=lfs merge=lfs -text
public/stations/360/*.webp filter=lfs diff=lfs merge=lfs -text

# Dialog-Audio (Cookie-geschützt, GET /api/dialog/…, ADR-010)
content/dialog-audio/**/*.wav filter=lfs diff=lfs merge=lfs -text

# Coach-Audio (Cookie-geschützt, GET /api/coach/…, ADR-025)
content/coach-audio/*.wav filter=lfs diff=lfs merge=lfs -text

# Öffentliche Stations-Medien (public/media/{slug}/…)
public/media/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
public/media/**/*.wav filter=lfs diff=lfs merge=lfs -text
public/media/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
public/media/**/*.jpg filter=lfs diff=lfs merge=lfs -text
public/media/**/*.webp filter=lfs diff=lfs merge=lfs -text
