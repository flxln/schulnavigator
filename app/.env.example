# Basis-URL für QR-Generierung (`npm run generate:qr`) — ohne trailing slash
NEXT_PUBLIC_BASE_URL=https://39-gs.mpz.schule

# Mobil-Test im LAN: LAN-IP für Next.js allowedDevOrigins (Komma-getrennt)
# Beispiel: ALLOWED_DEV_ORIGINS=192.168.0.136
# ALLOWED_DEV_ORIGINS=

# Optional: QR-Pixelbreite (Default 512)
# QR_PRINT_WIDTH_PX=512

# Delightex-iframe im Medien-Panel (ADR-017 Stufe 3); Build-Zeit-Variable
NEXT_PUBLIC_EMBED_ENABLED=true

# Zugangsmodus (ADR-021): gated (Default) | open
# SN_ACCESS_MODE=gated

# Entry-Tokens — Pflicht in Production bei gated (Coolify Runtime-Secret, nicht im Build)
# Post-Fest GS39: entry-fest-Token mit mode heft (gleicher QR-String, voller Hub)
# SN_ACCESS_TOKENS=[{"token":"fest-…","mode":"heft","expiresAt":"2027-07-31"},{"token":"heft-…","mode":"heft","expiresAt":"2027-07-31"}]

# Website-Einbettung per iframe (CSP frame-ancestors); kommagetrennte https-Origins
# SN_EMBED_ANCESTORS=https://www.beispiel-schule.de

# Nur lokal: Middleware setzt Heft-Cookie — alle Hub-Fenster klickbar (nicht in Produktion)
# DEV_UNLOCK_ALL=true

# MPZ Studio (ADR-022): Dev-only-Ingest-Tool — nur in app/.env.local, nie auf Coolify
# SN_MPZ_STUDIO_SECRET=…
# Session: POST /api/mpz/session mit Header x-mpz-studio-key → httpOnly-Cookie sn-mpz-studio

# Schüler-Medien Deploy (Bahn B, #230) — nur lokal, nie auf Coolify
# Alias Issue-Text: DEPLOY_SSH_HOST → DEPLOY_SSH (user@host)
# DEPLOY_SSH=admin@ionos-vps
# DEPLOY_REMOTE_BASE=/data/schulnavigator
# DEPLOY_BRANCH=kunde/39-gs
# DEPLOY_SSH_IDENTITY_FILE=~/.ssh/schulnavigator_deploy
# COOLIFY_DEPLOY_WEBHOOK_URL=https://…
