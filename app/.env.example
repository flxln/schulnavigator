# Basis-URL für QR-Generierung (`npm run generate:qr`) — ohne trailing slash
NEXT_PUBLIC_BASE_URL=https://schulnavigator.mpz.schule

# Mobil-Test im LAN: LAN-IP für Next.js allowedDevOrigins (Komma-getrennt)
# Beispiel: ALLOWED_DEV_ORIGINS=192.168.0.136
# ALLOWED_DEV_ORIGINS=

# Optional: QR-Pixelbreite (Default 512)
# QR_PRINT_WIDTH_PX=512
